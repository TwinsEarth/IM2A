# 复制为 .env 后填写（不要提交真实密钥）
IM2AGENT_DOMAIN=im.example.com

# 生产形态必须设置 ADMIN_TOKEN（≥8 字符），否则服务拒绝启动
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# 存储：生产建议 postgres（本原型未实现 pg 驱动，会显式报 STORE_NOT_AVAILABLE），
# 过渡期用 jsonfile 挂卷落盘；不要用 memory。
STORE=jsonfile
STORE_FILE=/data/state.json

# 大模型（可选）：填 key 走真实 LLM；不填走确定性模板（demo/降级均可用）
IM2AGENT_LLM_KEY=
IM2AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
IM2AGENT_LLM_MODEL=deepseek-chat
IM2AGENT_LLM_TIMEOUT_MS=8000

# 可选：PostgreSQL 连接串（当前仅记录在配置里，未接驱动）
# POSTGRES_URL=postgres://im2agent:password@db:5432/im2agent
