# SPDX-License-Identifier: MIT
# Template for /etc/im2a/env (installed 0600 root:root by deploy/vultr/install.sh).
#
# NEVER commit real secrets. install.sh generates each *_TOKEN / *_SECRET with
# `openssl rand -hex 32` ONLY when the key is absent, and never overwrites an existing value
# (use `install.sh --rotate-secrets` for an explicit rotation).
#
# Format: systemd EnvironmentFile - plain KEY=VALUE lines, no `export`, no quotes needed.
# The file is read by im2a-gateway.service as root; keep it 0600.

# --- Admin probe token (protects /healthz, /metrics, /v1/ops/*) ----------------------------
# If empty, internal/auth skips auth entirely (dev mode) => the probe endpoints become public.
IM2A_ADMIN_TOKEN=__GENERATE__

# --- Bearer token for the business API middleware chain (auth.Authenticate) ----------------
GATEWAY_TOKEN=__GENERATE__

# --- JWT signing secret for /v1/auth/login + /v1/auth/me ----------------------------------
# Empty => gateway logs "WARN: IM2A_JWT_SECRET not set; using insecure dev secret".
IM2A_JWT_SECRET=__GENERATE__

# --- 端侧出站白名单（逗号分隔 host，不含 scheme）------------------------------------------
# **未设置 = 拒绝一切出站（fail-closed）**
# 升级注意：旧版本"空白名单=全放行"，新版本改为 fail-closed；如需出站必须显式配置。
# 例：IM2A_EGRESS_ALLOW=api.example.com,localhost
IM2A_EGRESS_ALLOW=

# --- OpenClaw sub-plugin (bundled, MIT; on-demand runtime on this host) --------------------
# OPENCLAW_ENABLED=0 turns the plugin off entirely (state "disabled", IM2A unaffected).
OPENCLAW_ENABLED=1
OPENCLAW_BIN=/usr/local/node24/bin/openclaw
OPENCLAW_HOME=/root
OPENCLAW_CHANNEL=openclaw-weixin
OPENCLAW_ACCOUNTS_DIR=/root/.openclaw/openclaw-weixin/accounts
# external = CLI subprocesses only (no resident OpenClaw gateway). "managed" would let the
# plugin try to start `openclaw gateway`, which measured OOM on this host - see README §6.
OPENCLAW_GATEWAY_MODE=external
# This host runs OpenClaw on-demand (CLI subprocesses); the resident gateway does not fit in
# 959 MB RAM next to the w2m fleet - see README "OpenClaw 内存可行性". No resident mode var
# is set on purpose.

# --- Optional storage / model wiring (not required to start; endpoints degrade w/o them) ---
# PG_DRIVER=pgx
# PG_DSN=postgres://user:pass@127.0.0.1:5432/im2a?sslmode=disable
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# L4_ENABLED=off
# WEBHOOK_ASYNC=on
# RATE_LIMIT_RPS=100
# RATE_LIMIT_BURST=200
# CORS_ALLOWED=https://geefish.cn,https://www.geefish.cn
