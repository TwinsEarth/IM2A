{
  "name": "@twinsearth/im2a-platform",
  "version": "2.3.45",
  "private": true,
  "type": "module",
  "description": "IM2A v2.3.45 platform monorepo (P0 scaffold; no release yet)",
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
