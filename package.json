{
    "name":  "@twinsearth/im2a-platform",
    "version":  "2.5.0",
    "private":  true,
    "type":  "module",
    "description":  "IM2A v2.5.0 Agent Plugins 2.0 platform",
    "packageManager":  "pnpm@10.0.0",
    "workspaces":  [
                       "packages/*",
                       "apps/*"
                   ],
    "scripts":  {
                    "validate":  "node scripts/validate.mjs",
                    "compat":  "node scripts/compat-check.mjs",
                    "healthz":  "node scripts/healthz.mjs",
                    "allowlist":  "node scripts/check-release-allowlist.mjs",
                    "bridge:contracts":  "node scripts/check-bridge-contracts.mjs",
                    "release:dry-run":  "node scripts/release-dry-run.mjs",
                    "test":  "node packages/agent-plugins/generator/src/cli.mjs generate \u0026\u0026 node tests/p0.test.mjs",
                    "test:ci":  "node packages/agent-plugins/generator/src/cli.mjs generate \u0026\u0026 node --test tests/*.test.mjs",
                    "generate":  "node packages/agent-plugins/generator/src/cli.mjs generate",
                    "generate:check":  "node packages/agent-plugins/generator/src/cli.mjs check",
                    "trajectory:check":  "node scripts/check-trajectory-contract.mjs \u0026\u0026 node scripts/check-trajectory-pipeline.mjs",
                    "skill:test":  "node --test packages/skill-runtime/test/skill-runtime.test.mjs",
                    "agent-plugins:check":  "node scripts/check-agent-plugins-2.mjs",
                    "realtime:check":  "node scripts/validate-realtime.mjs",
                    "skill:sqlite-test":  "node --test packages/skill-runtime/test/sqlite-store.test.mjs",
                    "skill:perf":  "node scripts/bench-skill-runtime.mjs"
                },
    "engines":  {
                    "node":  "\u003e=22"
                },
    "license":  "MIT"
}