{
  "name": "@twinsearth/im2a-platform",
  "version": "2.7.2",
  "private": true,
  "type": "module",
  "description": "IM2A v2.7.2 contribution chain audit",
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "pin:check": "node scripts/pin-check.mjs",
    "compat": "node scripts/compat-check.mjs",
    "healthz": "node scripts/healthz.mjs",
    "allowlist": "node scripts/check-release-allowlist.mjs",
    "bridge:contracts": "node scripts/check-bridge-contracts.mjs",
    "layer:contracts": "node scripts/check-layer-contracts.mjs",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "test": "node packages/agent-plugins/generator/src/cli.mjs generate && node tests/p0.test.mjs",
    "test:ci": "node packages/agent-plugins/generator/src/cli.mjs generate && node --test tests/*.test.mjs",
    "generate": "node packages/agent-plugins/generator/src/cli.mjs generate",
    "generate:check": "node packages/agent-plugins/generator/src/cli.mjs check",
    "trajectory:check": "node scripts/check-trajectory-contract.mjs && node scripts/check-trajectory-pipeline.mjs",
    "skill:test": "node --test packages/skill-runtime/test/skill-runtime.test.mjs",
    "agent-plugins:check": "node scripts/check-agent-plugins-2.mjs",
    "realtime:check": "node scripts/validate-realtime.mjs",
    "skill:sqlite-test": "node --test packages/skill-runtime/test/sqlite-store.test.mjs",
    "skill:perf": "node scripts/bench-skill-runtime.mjs",
    "memory:test": "node --test packages/memory-hub/test/memory-hub.test.mjs",
    "trace:test": "node tests/trace-ingest.test.mjs",
    "reflect:test": "node tests/reflect-trigger.test.mjs",
    "curator:test": "node tests/curator-audit.test.mjs",
    "guard:test": "node tests/skill-guard.test.mjs",
    "memory:recall-test": "node tests/memory-recall-v2.test.mjs",
    "evolution:test": "node tests/evolution-pipeline.test.mjs && node tests/evolution-freeze.test.mjs",
    "drives:test": "node tests/drives-goal-buffer.test.mjs",
    "propose:test": "node tests/drive-propose.test.mjs",
    "scheduler:test": "node tests/scheduler.test.mjs",
    "goal-schedule:test": "node tests/goal-schedule.test.mjs",
    "calibrate:test": "node tests/drive-calibrate.test.mjs",
    "arbitration:test": "node tests/goal-arbitration.test.mjs",
    "persistence:test": "node tests/goal-persistence.test.mjs",
    "governance:test": "node tests/scheduler-governance.test.mjs",
    "autonomy:test": "node tests/autonomy-pipeline.test.mjs",
    "metadata:test": "node tests/skill-metadata.test.mjs",
    "claim:test": "node tests/skill-claim.test.mjs",
    "audit:test": "node tests/contribution-audit.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
