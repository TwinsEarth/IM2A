# AgentIM 演示：大模型与 fleet 配置（复制为 .env 或直接设为环境变量；不要提交真实密钥）
# --- DeepSeek-V4.1-Flash（OpenAI 兼容） ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash
LLM_BASE_URL=https://api.deepseek.com/v1
# 可选预算（每小时）
LLM_MAX_CALLS_PER_HOUR=120
LLM_MAX_TOKENS_PER_HOUR=200000
# --- DSH + W2M fleet（可选；缺省 simulated） ---
W2M_RELAY_URL=http://202.182.123.154:8787
W2M_OPERATOR_TOKEN=
W2M_DEVICE_TOKEN=

# --- 登录鉴权（生产必开；Demo 默认关闭）---
IM_AUTH=1
IM_SESSION_SECRET=change-me-to-a-long-random-string
IM_PASSWORD_LIN=change-me
IM_PASSWORD_ZHOU=change-me
IM_PASSWORD_MOM=change-me

# --- HTTPS（PEM 文件路径；不设则 http）---
IM_TLS_CERT=/etc/agent-im/tls/fullchain.pem
IM_TLS_KEY=/etc/agent-im/tls/privkey.pem

# --- SQLite 持久化（默认 <repo>/.data/agentim.db）---
IM_DB_PATH=
