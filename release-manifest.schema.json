{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://im2a.dev/schemas/release-manifest-1.0.json",
  "title": "IM2A release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platformVersion",
    "releaseTag",
    "goVersion",
    "status",
    "commit",
    "generatedAt",
    "components",
    "protocols",
    "artifacts",
    "nineGates",
    "healthz",
    "rollback"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "platformVersion": { "type": "string", "pattern": "^2\\.4\\.[0-9]+$" },
    "releaseTag": { "type": "string", "pattern": "^v2\\.4\\.[0-9]+$" },
    "goVersion": { "type": "string", "pattern": "^2\\.3\\.[0-9]+$" },
    "status": {
      "type": "string",
      "enum": ["draft", "ready", "published", "rolled_back"]
    },
    "commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "generatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "kind", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "protocolVersion", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "protocolVersion": { "type": "string", "minLength": 1 },
          "patchRelease": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pinned", "draft", "pending-official-confirmation"]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "size"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "signature": { "type": ["string", "null"] }
        }
      }
    },
    "nineGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tag",
        "Release",
        "npm",
        "CI",
        "Compat",
        "Release workflow",
        "npm-publish",
        "healthz"
      ],
      "properties": {
        "commit": { "$ref": "#/$defs/gate" },
        "tag": { "$ref": "#/$defs/gate" },
        "Release": { "$ref": "#/$defs/gate" },
        "npm": { "$ref": "#/$defs/gate" },
        "CI": { "$ref": "#/$defs/gate" },
        "Compat": { "$ref": "#/$defs/gate" },
        "Release workflow": { "$ref": "#/$defs/gate" },
        "npm-publish": { "$ref": "#/$defs/gate" },
        "healthz": { "$ref": "#/$defs/gate" }
      }
    },
    "healthz": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "imBot", "browser", "wechat", "openclaw", "agent", "ops"],
      "properties": {
        "gateway": { "$ref": "#/$defs/check" },
        "imBot": { "$ref": "#/$defs/check" },
        "browser": { "$ref": "#/$defs/check" },
        "wechat": { "$ref": "#/$defs/check" },
        "openclaw": { "$ref": "#/$defs/check" },
        "agent": { "$ref": "#/$defs/check" },
        "ops": { "$ref": "#/$defs/check" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tag", "reason"],
      "properties": {
        "commit": { "type": ["string", "null"] },
        "tag": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["ready", "published", "rolled_back"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "components": { "minItems": 1 },
          "artifacts": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "running", "passed", "failed", "blocked"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "command", "exitCode", "at"],
            "properties": {
              "check": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "exitCode": { "type": "integer" },
              "at": { "type": "string", "format": "date-time" },
              "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "runUrl": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "blocked"]
        },
        "detail": { "type": "string" }
      }
    }
  }
}
