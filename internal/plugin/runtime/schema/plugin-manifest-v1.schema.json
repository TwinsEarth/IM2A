{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://im2a.dev/schemas/plugin-manifest-v1.json",
  "title": "IM2A Plugin Manifest v1",
  "description": "Wave D1 插件 manifest。canonical JSON 的 sha256 即 manifest_hash，签名对象是该摘要。",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "required": ["apiVersion", "id", "name", "version", "kind", "api", "publisher", "entrypoint", "provides", "permissions", "attribution"],
  "properties": {
    "apiVersion": { "const": "im2a.plugin/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "kind": { "enum": ["K0", "K1", "K2"] },
    "api": { "const": "im2a.capability/v1" },
    "minKernelVersion": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "publisher": {
      "type": "object", "additionalProperties": false, "required": ["id", "keyId"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{8,64}$" }
      }
    },
    "entrypoint": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["inprocess", "exec", "remote"] },
        "module": { "type": "string" },
        "path": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
        "cwd": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "url": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "inprocess" } }, "required": ["type"] }, "then": { "required": ["module"] } },
        { "if": { "properties": { "type": { "const": "exec" } }, "required": ["type"] }, "then": { "required": ["path"] } },
        { "if": { "properties": { "type": { "const": "remote" } }, "required": ["type"] }, "then": { "required": ["url"] } }
      ]
    },
    "targets": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(linux|darwin|windows)/(amd64|arm64)$" }
    },
    "provides": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" },
          "version": { "type": "string", "pattern": "^v[0-9]+$" },
          "modes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "exclusive": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 }
        }
      }
    },
    "requires": { "type": "array", "items": { "$ref": "#/$defs/capRef" }, "uniqueItems": true },
    "optional_requires": { "type": "array", "items": { "$ref": "#/$defs/capRef" }, "uniqueItems": true },
    "requires_plugins": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["class", "scope"],
        "properties": {
          "class": {
            "enum": ["storage.read", "storage.write", "net.outbound", "fs.read", "fs.write", "exec", "secrets", "eventbus.publish", "eventbus.subscribe", "capability.call", "http.admin"]
          },
          "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "uniqueItems": true }
        }
      }
    },
    "configSchema": { "type": "string" },
    "health": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "enum": ["exec", "rpc", "http"] },
        "target": { "type": "string" },
        "grace": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "timeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "failures": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "startTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "stopTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "restart": { "enum": ["always", "on-failure", "never"] },
        "maxRestarts": { "type": "integer", "minimum": 0 },
        "restartWindow": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" }
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "memoryMax": { "type": "string", "pattern": "^[0-9]+(MiB|GiB)$" },
        "cpuMax": { "type": "string" },
        "pidsMax": { "type": "integer", "minimum": 0 }
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "keepVersions": { "type": "integer", "minimum": 1, "maximum": 5 },
        "autoRollback": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "healthFailures": { "type": "integer", "minimum": 0 },
            "errorRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "minRequests": { "type": "integer", "minimum": 0 },
            "window": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "bakeTime": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" }
          }
        }
      }
    },
    "attribution": {
      "type": "object", "additionalProperties": false, "required": ["license", "copyright", "upstream"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "copyright": { "type": "string", "minLength": 1 },
        "upstream": { "type": "string", "minLength": 1 },
        "upstreamName": { "type": "string" },
        "noticePath": { "type": "string" },
        "derived": { "type": "boolean" },
        "usage": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "capRef": {
      "type": "object", "additionalProperties": false, "required": ["capability"],
      "properties": {
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" },
        "version": { "type": "string", "pattern": "^v[0-9]+$" }
      }
    }
  }
}
