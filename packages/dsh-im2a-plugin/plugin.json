{
  "schemaVersion": "3.0",
  "name": "dsh-im2a-plugin",
  "version": "3.4.0",
  "engines": { "dsh": "0.2.2-rc.5" },
  "description": "IM2A — an instant network for agents: kernel plus nine capability modules in one package.",
  "display": {
    "title": "智能体宇宙—IM2A",
    "title_en": "Agent Universe — IM2A",
    "description": "一个面向 Agent 开发&开放的即时连接网络：让每个人都拥有自己专属的 AI 秘书、助理与管家&团队。传统 IM 连接人，人类被海量信息奴役；IM2A 连接 Agent 网络，人类退居幕后，掌握最终裁决权。这不仅是 IM，更是 AGI 时代个人生活方式的「数字平权」基础设施。",
    "locales": ["zh", "en"],
    "icon": "icon.svg",
    "packageName": "@twinsearth/dsh-im2a-plugin"
  },
  "license": "MIT",
  "toolNamespace": {
    "externalPrefix": "im2a_",
    "externalSeparator": "_",
    "internalSeparator": ".",
    "note": "MCP wire names use underscores; the dotted form is documentation and config only."
  },
  "kernel": {
    "module_version": "1.1.0",
    "status": "available",
    "constitution_hash": null,
    "constitution_hash_note": "null until the v3.1.6 / v3.2.6 schema freeze is recorded",
    "meta_tools": [
      "status",
      "pipeline",
      "gate_check",
      "constitution_audit",
      "module_list",
      "module_set",
      "config_get",
      "config_set",
      "license_status"
    ],
    "meta_tools_status": "partial",
    "meta_tools_note": "only status is implemented (served by the bridge as im2a_kernel_status); the other eight have no handler yet and are design-only, never advertised as callable",
    "tools": ["whoami"],
    "runtime_modules": [
      {
        "id": "model_registry",
        "path": "kernel/model-registry.mjs",
        "layer": "L1->L2",
        "status": "available",
        "provides": ["declared capability manifests", "cost estimation", "endpoint selection"]
      },
      {
        "id": "resource_meter",
        "path": "kernel/meter.mjs",
        "layer": "L6->L2",
        "status": "available",
        "provides": ["metering records", "three-pool marginal budget with reserved floor"]
      },
      {
        "id": "ui_artifact",
        "path": "kernel/ui-artifact.mjs",
        "layer": "L5.2->L2",
        "status": "available",
        "provides": ["instant-world artifact contract", "ephemeral/promoted state machine"]
      },
      {
        "id": "did_portability",
        "path": "kernel/did-portability.mjs",
        "layer": "L4",
        "status": "available",
        "provides": ["DID-bound export bundle", "same-DID import plan with read-only history proof"]
      },
      {
        "id": "topology_metrics",
        "path": "kernel/topology-metrics.mjs",
        "layer": "L2/L6",
        "status": "available",
        "provides": ["node_count", "quality_index", "attribution_precision", "snapshot digest"]
      },
      {
        "id": "scope_governance",
        "path": "kernel/scope-governance.mjs",
        "layer": "L3/C1",
        "status": "partial",
        "status_note": "propose and status are exposed as governance_manage; human decisions are recorded outside the MCP surface",
        "provides": ["scope proposals", "human-only approval", "direct physical grant"]
      }
    ]
  },
  "runtime": {
    "transport": "streamable-http",
    "serverName": "im2a",
    "url": "http://127.0.0.1:18082/mcp",
    "catalog": "mcp-bridge-tool-catalog-2.0",
    "note": "This is the callable surface: the tools the MCP bridge actually serves. kernel.tools / kernel.meta_tools / modules[].tools describe the design surface; where the two differ, the bridge wins at runtime and kernel/registry.mjs reports the gap instead of pretending the design names are callable.",
    "tools": [
      "im2a_harness_list",
      "im2a_send",
      "im2a_recv",
      "im2a_presence",
      "im2a_whoami",
      "im2a_history",
      "skills_list",
      "skill_view",
      "skill_manage",
      "curator",
      "memory_search",
      "memory_get",
      "memory_propose",
      "trace_ingest",
      "reflect_trigger",
      "curator_audit",
      "skill_guard_check",
      "memory_recall_v2",
      "evolution_pipeline_dryrun",
      "drive_list",
      "drive_manage",
      "goal_buffer",
      "drive_propose",
      "scheduler_cycle",
      "scheduler_audit",
      "goal_schedule",
      "drive_calibrate",
      "autonomy_pipeline_dryrun",
      "skill_claim",
      "contribution_audit",
      "governance_manage",
      "im2a_kernel_status"
    ]
  },
  "modules": {
    "memory": {
      "module_version": "2.5.8",
      "status": "available",
      "required_scopes": ["memory:read"],
      "deps": [],
      "soft_deps": [],
      "tools": ["search", "get", "propose", "recall"]
    },
    "evolution": {
      "module_version": "2.5.9",
      "status": "available",
      "required_scopes": ["trace:write"],
      "deps": [],
      "soft_deps": [],
      "tools": ["ingest", "reflect", "curator", "curator_audit"]
    },
    "asset": {
      "module_version": "3.3.0",
      "status": "available",
      "required_scopes": ["skill:write"],
      "deps": ["memory", "evolution"],
      "soft_deps": [],
      "tools": ["view", "manage", "claim", "list", "audit", "guard_check"],
      "runtime_modules": ["ui_artifact"]
    },
    "identity": {
      "module_version": "2.8.9",
      "status": "partial",
      "status_note": "DID-bound portability (L4) is implemented; verification tiers and credit attestation are still planned",
      "required_scopes": ["credit:attest"],
      "deps": ["asset", "evolution"],
      "soft_deps": [],
      "tools": [],
      "runtime_modules": ["did_portability"]
    },
    "autonomy": {
      "module_version": "2.6.9",
      "status": "available",
      "required_scopes": ["autonomy:drive"],
      "deps": ["memory", "asset", "evolution"],
      "soft_deps": [],
      "tools": [
        "drive_list",
        "drive_manage",
        "propose",
        "calibrate",
        "buffer",
        "schedule",
        "scheduler_cycle",
        "scheduler_audit"
      ]
    },
    "economy": {
      "module_version": "2.9.9",
      "status": "partial",
      "status_note": "metering and model-cost estimation are implemented in the kernel; no economy MCP tool is exposed yet",
      "required_scopes": ["economy:node"],
      "deps": ["asset", "identity"],
      "soft_deps": ["observability"],
      "tools": [],
      "runtime_modules": ["model_registry", "resource_meter"]
    },
    "fleet": {
      "module_version": "3.0.6",
      "status": "available",
      "required_scopes": ["fleet:coordinate"],
      "deps": ["asset", "autonomy"],
      "soft_deps": ["economy"],
      "tools": ["harness_list", "send", "recv", "presence", "history"]
    },
    "governance": {
      "module_version": "3.3.0",
      "status": "partial",
      "status_note": "proposal and status are exposed as governance_manage; human approval is recorded outside the MCP surface",
      "required_scopes": ["governance:vote"],
      "deps": ["identity"],
      "soft_deps": ["observability"],
      "tools": ["manage"],
      "runtime_modules": ["scope_governance"]
    },
    "observability": {
      "module_version": "3.3.0",
      "status": "partial",
      "status_note": "pipeline dry-run and topology metrics; drift, meta_evolve and telemetry_ingest are not implemented",
      "required_scopes": ["observability:read"],
      "deps": [],
      "soft_deps": [],
      "tools": ["pipeline_dryrun"],
      "runtime_modules": ["topology_metrics"]
    }
  },
  "premium": {
    "relay_required": true,
    "license_implemented": false,
    "license_note": "no Relay handshake or license verification code exists in this repository yet",
    "modules": {
      "deploy_local": { "status": "planned", "requires_signature": true },
      "enterprise_net": { "status": "planned", "requires_signature": true },
      "cloud_backup": { "status": "planned", "requires_signature": true },
      "token_router": { "status": "planned", "requires_signature": true },
      "team_permissions": { "status": "planned", "requires_signature": true }
    }
  },
  "aliases": "migrations/3.2.1-tool-aliases.json"
}
