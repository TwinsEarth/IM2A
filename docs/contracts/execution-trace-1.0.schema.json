{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://im2a.dev/schemas/execution-trace-1.0.json",
  "title": "IM2A execution trace 1.0",
  "description": "Append-only execution trace batch written by trace_ingest. It records span metadata and SHA-256 digests only; raw prompts, tool arguments, tool outputs, credentials and free-form memory are structurally rejected. The attribute names follow the OpenTelemetry GenAI semantic-convention naming space, with IM2A extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "tenant",
    "agent_did",
    "session_id",
    "received_at",
    "events",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "agent_did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[A-Za-z0-9._:%-]{3,200}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/event" }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "span_id",
        "span_type",
        "name",
        "input_digest",
        "output_digest",
        "duration_ms",
        "token_cost",
        "success",
        "error_class",
        "occurred_at",
        "attributes"
      ],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "span_type": {
          "enum": ["tool_call", "llm_call", "retrieval", "skill_load"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_digest": { "$ref": "#/$defs/digest" },
        "output_digest": { "$ref": "#/$defs/digest" },
        "duration_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600000
        },
        "token_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "success": { "type": "boolean" },
        "error_class": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gen_ai.operation.name",
            "im2a.agent_did",
            "im2a.skill_version"
          ],
          "properties": {
            "gen_ai.operation.name": {
              "enum": ["chat", "execute_tool", "retrieval"]
            },
            "gen_ai.tool.name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "gen_ai.usage.total_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "im2a.agent_did": {
              "type": "string",
              "pattern": "^did:[a-z0-9]+:[A-Za-z0-9._:%-]{3,200}$"
            },
            "im2a.skill_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "success": { "const": false } },
            "required": ["success"]
          },
          "then": {
            "properties": {
              "error_class": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "span_type": { "const": "skill_load" } },
            "required": ["span_type"]
          },
          "then": {
            "properties": {
              "attributes": {
                "properties": {
                  "im2a.skill_version": { "minLength": 1, "not": { "const": "none" } }
                }
              }
            }
          }
        }
      ]
    }
  }
}
