{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://im2a.dev/contracts/goal-buffer-1.0.schema.json",
  "title": "IM2A v2.6.0 local goal buffer object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_id", "drive_id", "proposed_at", "intent_summary", "source_signals",
    "priority_score", "status", "created_at", "updated_at"
  ],
  "properties": {
    "goal_id": { "type": "string", "pattern": "^goal_[0-9a-f]{24}$" },
    "drive_id": { "type": "string", "minLength": 1 },
    "proposed_at": { "type": "string", "format": "date-time" },
    "intent_summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "source_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id"],
        "properties": {
          "type": { "enum": ["skill", "memory_item"] },
          "id": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "priority_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["pending", "scheduled", "executing", "completed", "expired"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
