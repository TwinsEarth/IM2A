{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://im2a.dev/contracts/skill-claim-1.0.schema.json",
  "title": "IM2A v2.7.x simulated skill_claim input, frozen by v2.6.9",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "agent_did", "draft_patch", "source_signals", "recommended_next"],
  "properties": {
    "goal_id": { "type": "string", "pattern": "^goal_[0-9a-f]{24}$" },
    "agent_did": { "type": "string", "minLength": 1 },
    "intent_summary": { "type": "string", "minLength": 1 },
    "source_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id"],
        "properties": {
          "type": { "enum": ["skill", "memory_item"] },
          "id": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "draft_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_id", "target_skill_id", "path", "sha256", "bytes", "applied"],
      "properties": {
        "draft_id": { "type": "string", "pattern": "^draft_[0-9a-f]{24}$" },
        "target_skill_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "applied": { "const": false }
      }
    },
    "recommended_next": { "enum": ["crystallize", "patch", "discard"] },
    "contribution_log_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id"],
      "properties": {
        "goal_id": { "type": "string", "pattern": "^goal_[0-9a-f]{24}$" },
        "drive_id": { "type": "string" }
      }
    }
  }
}
